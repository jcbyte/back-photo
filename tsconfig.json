{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "allowJs": true,
    "module": "ESNext",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/renderer/*"
      ]
    }
  },
  "include": [
    "./src/**/*",
    "./*.config.ts",
    "./*.config.mts"
  ]
}